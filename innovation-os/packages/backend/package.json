{
  "name": "@innovationos/backend",
  "version": "1.0.0",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@google/generative-ai": "0.15.0",
    "@prisma/client": "5.16.1",
    "@react-pdf/renderer": "3.4.4",
    "cors": "2.8.5",
    "express": "4.19.2",
    "openai": "4.52.7",
    "pino": "9.3.1",
    "pino-pretty": "11.2.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "fast-check": "3.19.0",
    "jest": "29.7.0",
    "prisma": "5.16.1",
    "ts-jest": "29.2.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "globalSetup": "<rootDir>/src/lib/__tests__/jest.setup.ts",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "@innovationos/shared": "<rootDir>/../shared/src"
    }
  }
}
